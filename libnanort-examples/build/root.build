# The `bidir_path_tracer` example uses an old version of
# 'tinyobjloader' that uses the C++ `register` keyword.
# This is no longer allowed starting with C++17.
# Thus, we reduce the required standard to C++14.
#
cxx.std = 14

using cxx

hxx{*}: extension = h
cxx{*}: extension = cc

hxx{*}: cxx.importable = false

test.target = $cxx.target

# The examples need a very long time to run.
# So, we disable tests by default for now.
#
# exe{*}: test = true
